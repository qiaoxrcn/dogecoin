# Copy this file to .env and set the RPC password before starting.
DOGECOIN_RPC_PASSWORD=
DOGECOIN_RPC_USER=explorer

# Bind to the server's private IP if other machines need RPC/P2P access.
DOGECOIN_BIND_IP=127.0.0.1
DOGECOIN_RPC_PORT=18332
DOGECOIN_P2P_PORT=18444

# Tested image; change the tag to latest if you want to follow new builds.
DOGECOIN_IMAGE=ghcr.io/qiaoxrcn/dogecoin-regtest-testnet:0861802693271c3a4e821999435ca57a676d4eb6
