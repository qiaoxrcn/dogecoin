# Runtime image for the binaries built and tested by GitHub Actions.
# Build context: artifacts/dogecoin-regtest-testnet (contains bin/).
FROM ubuntu:22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
      libboost-system1.74.0 libboost-filesystem1.74.0 libboost-chrono1.74.0 \
      libboost-program-options1.74.0 libboost-thread1.74.0 libdb5.3++ \
      libevent-2.1-7 libevent-pthreads-2.1-7 libssl3 libzmq5 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home dogecoin \
    && mkdir /data && chown dogecoin:dogecoin /data

COPY bin/ /usr/local/bin/
COPY COPYING regtest-testnet.md COMMIT /usr/share/doc/dogecoin/

USER dogecoin
WORKDIR /data
VOLUME ["/data"]
EXPOSE 18332 18444
STOPSIGNAL SIGTERM

ENTRYPOINT ["dogecoind", "-regtest", "-regtesttestnet", "-datadir=/data", "-server=1", "-txindex=1", "-printtoconsole=1", "-connect=0", "-dnsseed=0", "-listenonion=0"]
